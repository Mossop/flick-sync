#!/bin/sh /etc/rc.common

USE_PROCD=1
# Start late so that external storage has a chance to be mounted.
START=99
STOP=10

PROG=/usr/libexec/flick-sync/start

# Allows the mDNS responses that cast device discovery relies on.
add_mdns_firewall_rule() {
	local zone=$1

	json_add_object ""
	json_add_string type rule
	json_add_string name "Allow-flick-sync-mDNS-$zone"
	json_add_string src "$zone"
	json_add_string proto udp
	json_add_string dest_port 5353
	json_add_string target ACCEPT
	json_close_object
}

start_service() {
	local enabled store port certificate private_key disable_syncing log_level
	local mdns_zones zone

	config_load flick-sync
	config_get_bool enabled main enabled 1
	config_get store main store
	config_get port main port 3000
	config_get certificate main certificate
	config_get private_key main private_key
	config_get_bool disable_syncing main disable_syncing 1
	config_get log_level main log_level warn
	config_get mdns_zones main mdns_zones lan

	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" --log-level "$log_level" serve --port "$port"
	[ -n "$certificate" ] && procd_append_param command --certificate "$certificate"
	[ -n "$private_key" ] && procd_append_param command --private-key "$private_key"
	[ "$disable_syncing" -eq 1 ] && procd_append_param command --disable-syncing
	# An empty store makes the start script search mounted storage for one.
	[ -n "$store" ] && procd_set_param env FLICK_SYNC_STORE="$store"
	# Retry forever every 10 seconds. The store will not be available until
	# the external storage it lives on has been mounted, and flick-sync exits
	# when the store is missing.
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/flick-sync

	# These rules only apply while the service is running.
	procd_open_data
	json_add_array firewall
	for zone in $mdns_zones; do
		add_mdns_firewall_rule "$zone"
	done
	json_close_array
	procd_close_data

	procd_close_instance
}

service_started() {
	procd_set_config_changed firewall
}

service_stopped() {
	procd_set_config_changed firewall
}

stop_service() {
	rm -f /var/run/flick-sync/store
}

service_triggers() {
	procd_add_reload_trigger "flick-sync"
}
