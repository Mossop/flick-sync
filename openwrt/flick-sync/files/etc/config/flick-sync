config flick-sync 'main'
	# Set to '0' to prevent the service from starting.
	option enabled '1'
	# The directory to store synced media and state in. Leave blank to search
	# mounted external storage: the root of every partition under /tmp/mountd
	# and every directory one level below is checked for a flicksync.json file.
	option store ''
	# The port for the web interface. Port 80 is used by LuCI.
	option port '3000'
	# Optional TLS certificate and private key (PEM) to serve over HTTPS.
	option certificate ''
	option private_key ''
	# Set to '0' to sync from Plex. By default existing content is served only.
	option disable_syncing '1'
	# Only log messages at this level or above: error, warn, info, debug or trace.
	option log_level 'warn'
	# Firewall zones that cast devices can be used from while the service is
	# running. Opens mDNS (UDP port 5353), used to discover cast devices, and
	# the web interface port, used by cast devices to fetch media. Use
	# 'lan wan' to also use cast devices on the WAN side. Zones other than 'lan'
	# only accept traffic from private network addresses.
	option mdns_zones 'lan'
	# A name in the local domain (e.g. media.lan) for reaching the web interface
	# without a port. While the service runs, hostname_address is added to the
	# LAN, the name is published for it and port 80 on it is forwarded to the
	# web interface. Choose an unused address in the LAN subnet outside of the
	# DHCP range. Nothing is done unless an address is set.
	option hostname 'media'
	option hostname_address ''
